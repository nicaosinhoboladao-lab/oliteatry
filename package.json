{
  "name": "oliteatry",
  "productName": "OLiteatry",
  "version": "0.1.0",
  "description": "Open-source desktop studio for virtual theater, avatar performance and machinima. Parchment-and-violet UI, PS2-era post stack, procedural idle motion engine.",
  "license": "Apache-2.0",
  "author": "OLiteatry contributors",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "selftest": "electron . --selftest",
    "test": "vitest run",
    "icon": "electron . --make-icon",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:zip": "node tools/package-win.mjs",
    "locales": "node tools/check-locales.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "build": {
    "appId": "org.oliteatry.studio",
    "productName": "OLiteatry",
    "copyright": "Copyright © 2026 OLiteatry contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "OLiteatry-${version}-windows-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OLiteatry-${version}-setup.exe"
    }
  }
}
